{
	// The hosted URL (serve.mjs) as a Cloudflare Worker. The Worker is the origin for lookwhaticando.dev; Cloudflare manages its DNS record.
	"name": "look-what-i-can-do",
	"main": "serve.mjs",
	"compatibility_date": "2026-09-24",
	// The landing page. Only / runs the Worker first, so it can send curl the plain-text usage instead.
	"assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": ["/"] },
	"routes": [{ "pattern": "lookwhaticando.dev", "custom_domain": true }]
}
